{
  "info": {
    "name": "MetricRaw API",
    "description": "Full collection for MetricRaw Django Backend with automatic JWT token management.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"athlete1\",\n  \"email\": \"athlete1@example.com\",\n  \"first_name\": \"Alex\",\n  \"last_name\": \"Raw\",\n  \"password\": \"Password123!\",\n  \"password2\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/register/", "host": ["{{baseUrl}}"], "path": ["api", "register", ""] }
          }
        },
        {
          "name": "Login (Auto-saves Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.access) {",
                  "    pm.collectionVariables.set('token', json.access);",
                  "    console.log('JWT Token saved!');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"athlete1\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login/", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login", ""] }
          }
        },
        {
          "name": "Admin Login (Superuser)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.access) {",
                  "    pm.collectionVariables.set('token', json.access);",
                  "    console.log('Admin Superuser Token saved!');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin_super\",\n  \"password\": \"AdminPassword123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login/", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login", ""] }
          }
        }
      ]
    },
    {
      "name": "2. Profile & Goals",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/profile/", "host": ["{{baseUrl}}"], "path": ["api", "profile", ""] }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"age\": 25,\n  \"height_cm\": 180,\n  \"weight_kg\": 76.5,\n  \"experience\": \"intermediate\",\n  \"equipment\": \"gym\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/profile/", "host": ["{{baseUrl}}"], "path": ["api", "profile", ""] }
          }
        },
        {
          "name": "Get Goals",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/goals/", "host": ["{{baseUrl}}"], "path": ["api", "goals", ""] }
          }
        },
        {
          "name": "Create Goal",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"goal\": \"muscle_gain\",\n  \"days_per_week\": 4,\n  \"session_minutes\": 60\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/goals/", "host": ["{{baseUrl}}"], "path": ["api", "goals", ""] }
          }
        }
      ]
    },
    {
      "name": "3. Workouts",
      "item": [
